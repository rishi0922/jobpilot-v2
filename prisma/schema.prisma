generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-user core ─────────────────────────────────────────────────────────
//
// User signs up via NextAuth (Credentials provider with email+password, or
// Google OAuth). The Account/Session/VerificationToken tables are the
// standard NextAuth Prisma adapter schema — don't rename or restructure.
//
// EmailAllowlist gates who can register: a user can only complete signup if
// their email is in the allowlist. Unlisted emails get redirected to the
// public /waitlist landing page. Add allowlist entries via the admin UI
// (built in commit 3) or directly in the DB.

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  // Hashed via bcryptjs. Nullable because Google OAuth users have no password.
  passwordHash    String?
  role            UserRole  @default(USER)   // ADMIN can manage the allowlist
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastSignInAt    DateTime?

  // NextAuth standard relations
  accounts        Account[]
  sessions        Session[]

  // App data — every user-scoped table cascades on user delete so removing a
  // user wipes their footprint without orphaning rows.
  profile         Profile?
  cvs             CV[]
  credentials     Credential[]
  jobs            Job[]
  cvAnalyses      CvAnalysis[]
  scraperRuns     ScraperRun[]
}

// NextAuth: OAuth account link (one per provider per user)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth: server-side session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// NextAuth: email verification / magic-link tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Email gate for signup. If a sign-up attempt comes in for an email NOT in
// this table, we redirect to /waitlist. Admins manage this list via
// /api/admin/allowlist (built in commit 4).
model EmailAllowlist {
  id         String   @id @default(cuid())
  email      String   @unique
  note       String?              // optional note: e.g. "friend from PM group"
  invitedBy  String?              // userId of admin who added them
  createdAt  DateTime @default(now())
}

// People who hit the waitlist landing page and asked for access. Admins
// review these and promote select entries to EmailAllowlist.
model WaitlistRequest {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  reason     String?              // optional "why are you interested?" answer
  status     WaitlistStatus @default(PENDING)
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
}

enum WaitlistStatus {
  PENDING
  APPROVED
  DECLINED
}

enum UserRole {
  USER
  ADMIN
}

// ── App models — every one is now user-scoped ──────────────────────────────
//
// IMPORTANT — `userId` is declared as String? (nullable) on every existing
// table (Job, CV, Credential, Profile, ScraperRun, CvAnalysis) so the
// initial `prisma db push` against a populated DB succeeds without a
// data-loss warning. The migration script (scripts/migrate-to-multiuser.ts)
// backfills userId on every existing row to point at the first admin user.
//
// Application-level enforcement still ensures every NEW row has a userId
// (every API route uses getCurrentUserId() and refuses requests without
// a session). DB-level NOT NULL is a defence-in-depth nice-to-have, not
// load-bearing for correctness.

model Job {
  id            String   @id @default(cuid())
  // User the job belongs to. Same sourceUrl can appear under multiple users
  // (e.g. two users searching for PM roles both find the same Naukri listing)
  // so the @unique on sourceUrl moves from "global" to compound with userId.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  company       String
  location      String?
  sourceUrl     String
  source        String   // linkedin, naukri, iimjobs, instahyre, hirist, wellfound, mnc, ats:greenhouse, ats:lever, ats:ashby
  roleType      RoleType
  description   String?
  salary        String?
  postedAt      DateTime?
  scrapedAt     DateTime @default(now())
  status        JobStatus @default(FOUND)
  applyMode     ApplyMode @default(AUTO)
  cvUsed        String?
  appliedAt     DateTime?
  lastUpdated   DateTime @updatedAt
  matchScore    Int?     // 0-100 match score (deterministic)
  matchNotes    String?  // human-readable match reasoning (multi-line)
  matchReasons  Json?    // structured score breakdown { factor: { weight, points, max, detail } }
  feedback      String?  // 'UP' | 'DOWN' | null — user's thumbs reaction

  applications  Application[]

  @@unique([userId, sourceUrl])
  @@index([userId])
  @@index([roleType])
  @@index([status])
  @@index([source])
  @@index([scrapedAt])
  @@index([matchScore])
}

model Application {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvId         String
  cv           CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  submittedAt  DateTime @default(now())
  status       AppStatus @default(SUBMITTED)
  errorLog     String?
  formFields   Json?
  responseNote String?

  @@index([jobId])
  @@index([status])
}

model CV {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleType     RoleType
  fileName     String
  fileUrl      String
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  analysisJson Json?    // cached AI analysis

  applications Application[]

  // One CV per role per user (was globally unique on roleType pre-multi-user)
  @@unique([userId, roleType])
  @@index([userId])
}

model Credential {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  siteName    String
  siteUrl     String
  username    String
  passwordEnc String   // AES-256 encrypted
  isActive    Boolean  @default(true)
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Each user can have one credential per site
  @@unique([userId, siteName])
  @@index([userId])
}

model ScraperRun {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt    DateTime @default(now())
  completedAt  DateTime?
  jobsFound    Int      @default(0)
  jobsApplied  Int      @default(0)
  jobsFailed   Int      @default(0)
  sources      String[] // which sources were scraped
  errorsJson   Json?
  status       RunStatus @default(RUNNING)
  sourceStats  Json?    // { source: { found, kept, droppedIrrelevant, droppedSenior, error? } }

  @@index([userId])
  @@index([startedAt])
}

// Per-user profile. The old singleton (id = "default") is gone — each user
// owns their own profile row, created on first sign-in via a NextAuth event
// callback (set up in lib/auth.ts).
model Profile {
  id                  String   @id @default(cuid())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String?
  email               String?
  phone               String?
  yearsExperience     Int?     // total years of relevant experience
  currentRole         String?
  expectedSalaryLpa   Int?     // expected salary in lakhs per annum (LPA, India context)
  noticePeriodDays    Int?
  skills              String[] // e.g. ["sql", "product analytics", "figma", "agile"]
  preferredLocations  String[] // e.g. ["bengaluru", "remote", "hybrid"]
  preferredIndustries String[] // e.g. ["fintech", "ecommerce", "saas"]
  searchQueries       String[] // per-user scraper queries; falls back to defaults if empty
  remoteOnly          Boolean  @default(false)
  minMatchScore       Int      @default(60) // auto-apply only above this score
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model CvAnalysis {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  cvId         String
  jobId        String?
  analysisType String   // pre_application | post_application | general
  matchScore   Int?
  strengths    String[]
  gaps         String[]
  suggestions  String[]
  keywords     String[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ── Enums (unchanged) ───────────────────────────────────────────────────────

enum RoleType {
  APM
  PM
  PROJECT_MANAGER
  PROGRAM_MANAGER
  BUSINESS_ANALYST
}

enum JobStatus {
  FOUND
  QUEUED
  APPLIED
  IN_REVIEW
  INTERVIEW
  REJECTED
  FAILED
  SKIPPED
}

enum AppStatus {
  SUBMITTED
  CONFIRMED
  FAILED
  PENDING
}

enum ApplyMode {
  AUTO
  MANUAL
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}
